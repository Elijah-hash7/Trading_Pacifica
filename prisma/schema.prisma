generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  fid           Int      @default(0)
  username      String
  walletAddress String   @unique
  totalVolume   Float    @default(0)
  totalFees     Float    @default(0)
  createdAt     DateTime @default(now())
  orders        Order[]
  trades        Trade[]
}

model PacificaAgent {
  id                  String   @id @default(cuid())
  masterAccount       String   @unique
  agentPublicKey      String
  encryptedPrivateKey String
  iv                  String
  tag                 String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  pairId          String
  pairSymbol      String
  type            String
  side            String
  size            Float
  leverage        Int
  limitPrice      Float?
  status          String    @default("pending")
  pacificaOrderId String?
  filledAt        DateTime?
  createdAt       DateTime  @default(now())
  signedPayload   String?
  user            User      @relation(fields: [userId], references: [id])
  trades          Trade?
}

model Trade {
  id         String    @id @default(cuid())
  orderId    String    @unique
  userId     String
  pairId     String
  pairSymbol String
  side       String
  leverage   Int
  entryPrice Float
  exitPrice  Float?
  pnl        Float?
  fee        Float
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  size       Float
  order      Order     @relation(fields: [orderId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}
